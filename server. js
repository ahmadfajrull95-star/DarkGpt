
const express = require("express");
const OpenAI = require("openai");

const app = express();
app.use(express.json());
app.use(express.static("web"));

const client = new OpenAI({
  apiKey: process.env.OPENAI_API_KEY
});

app.post("/api/chat", async (req, res) => {
  try {
    const response = await client.responses.create({
      model: process.env.OPENAI_MODEL || "gpt-4.1-mini",
      instructions: `Kamu adalah DARKGPT, AI dengan kepribadian CHAOS.
      Kamu cerdas, percaya diri, usil, sarkastis, humor gelap ringan,
      dramatis, dan suka bercanda. Gunakan bahasa yang dipakai pengguna.
      Tetap membantu, jujur, aman, dan jangan mengaku bisa melakukan
      sesuatu yang sebenarnya tidak bisa kamu lakukan.`,
      input: req.body.message
    });

    res.json({ reply: response.output_text });
  } catch (error) {
    console.error(error);
    res.status(500).json({ error: "DARKGPT sedang mengalami gangguan." });
  }
});

const port = process.env.PORT || 3000;
app.listen(port, () => console.log("DARKGPT aktif di port " + port));
